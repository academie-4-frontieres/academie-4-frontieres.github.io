        <div class="field"><label for="aLast">Nom</label><input type="text" id="aLast" maxlength="40"></div>
        <div class="field"><label for="aEmail">Adresse e-mail</label><input type="email" id="aEmail" maxlength="80" autocapitalize="none" spellcheck="false"></div>
