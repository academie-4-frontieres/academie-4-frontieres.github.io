function closePEditor(){ pEditing = null; $('prEditor').hidden = true; }
const val = (id) => ($(id)?.value ?? '').trim();
$('prForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const fn = $('prFormNotice');
  const first_names = val('pf_first').replace(/\s+/g,' '), last_name = val('pf_last').replace(/\s+/g,' '), email = val('pf_email').toLowerCase();
  if (!first_names || !last_name){ say(fn, 'Les prénoms et le nom sont obligatoires.', true); return; }
  if (email && !EMAIL_RE.test(email)){ say(fn, "L'adresse e-mail n'est pas valide.", true); return $('pf_email').focus(); }
  const birth = val('pf_birth');
  if (birth && (new Date(birth) > new Date() || age(birth) > 100)){ say(fn, 'La date de naissance est invalide.', true); return $('pf_birth').focus(); }
  const base = { first_names, last_name, phone: val('pf_phone') || null };
  if ($('pf_birth')) base.birth_date = birth || null;
  if ($('pf_status')) base.status = val('pf_status');
  const editingP = pEditing ? pers(pEditing) : null;
  if (!editingP?.auth_user_id) base.email = email || null;
  let playerId, relation;
  if (pType === 'parent' && !editingP){
    playerId = val('pf_player'); relation = val('pf_relation');
    if (!playerId){ say(fn, "Choisissez le joueur auquel ce parent est lié.", true); return; }
    const kids = parentsOf(playerId);
    if (kids.length >= 3){ say(fn, 'Ce joueur a déjà 3 parents : c\'est le maximum.', true); return; }
    const taken = kids.find(k => k.relation === relation);
    if (taken){ say(fn, `Le lien « ${REL_LABEL[relation]} » est déjà attribué à ${fullName(pers(taken.parent_id))} pour ce joueur.`, true); return; }
  }
  $('prSave').disabled = true; busy(true, 'Enregistrement…');
  try {
    let pid = editingP?.id;
    if (editingP){
      await q(sb.from('personnes').update(base).eq('id', pid));
    } else {
      const existing = email ? S.d.personnes.find(x => (x.email || '').toLowerCase() === email) : null;
      if (existing){
        if (pType !== 'parent' && rolesOf(existing.id).some(r => r.role === pType && r.discipline_id === S.disc.id)){ throw { message:`${fullName(existing)} a déjà ce profil dans cette discipline.` }; }
        pid = existing.id;
      } else {
        const row = await q(sb.from('personnes').insert(base).select().single());
        pid = row.id;
      }
      if (!rolesOf(pid).some(r => r.role === pType && r.discipline_id === S.disc.id))
        await q(sb.from('personne_roles').insert({ personne_id:pid, role:pType, discipline_id:S.disc.id }));
    }
    if (pType === 'joueur') await q(sb.from('fiches_joueur').upsert({ personne_id:pid, category:val('pf_cat') || null, position:val('pf_pos') || null, strong_foot:val('pf_foot') || null, licence_number:val('pf_lic') || null }, { onConflict:'personne_id' }));
    if (pType === 'formateur') await q(sb.from('fiches_formateur').upsert({ personne_id:pid, job_title:val('pf_job') || null, highest_diploma:val('pf_dip') || null, categories:[...document.querySelectorAll('input[name="pf_cats"]:checked')].map(c => c.value) }, { onConflict:'personne_id' }));
    if (pType === 'academicien_formateur') await q(sb.from('parcours_academicien_formateur').upsert({ personne_id:pid, target_diploma:val('pf_target') || null, start_date:val('pf_start') || null, tutor_id:val('pf_tutor') || null }, { onConflict:'personne_id' }));
    if (pType === 'parent' && !editingP) await q(sb.from('liens_parent').insert({ joueur_id:playerId, parent_id:pid, relation, is_primary: parentsOf(playerId).length === 0 }));
    await loadAll(); busy(false); closePEditor(); renderProfiles();
    say($('prNotice'), editingP ? `Profil de ${first_names} ${last_name.toUpperCase()} mis à jour.` : `Profil de ${first_names} ${last_name.toUpperCase()} créé.${email ? ` La personne peut maintenant créer son compte avec ${email}.` : ''}`);
  } catch (err) { busy(false); say(fn, err.code ? frErr(err) : (err.message || frErr(err)), true); await loadAll().catch(() => {}); }
  finally { $('prSave').disabled = false; }
});
$('prList').addEventListener('click', async (e) => {
  const b = e.target.closest('button[data-p]'); if (!b) return;
  const p = pers(b.dataset.id); if (!p) return;
  const n = $('prNotice');
  if (b.dataset.p === 'edit') return openPEditor(p);
