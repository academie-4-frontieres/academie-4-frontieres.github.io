      say(n, otherRoles.length
        ? `Touchez « Confirmer » pour retirer le profil ${PTYPES[pType].one} de ${fullName(p)} dans cette discipline. Ses autres profils sont conservés.`
        : `Touchez « Confirmer » pour supprimer définitivement la fiche de ${fullName(p)}${kids.length ? ` et ses liens avec ${kids.length} parent${kids.length > 1 ? 's' : ''}` : ''}${p.auth_user_id ? ' (son compte de connexion ne donnera plus accès à rien)' : ''}. Cette action est irréversible.`, true);
