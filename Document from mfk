const esc = (s) => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function onColor(hex){
  const h = /^#[0-9a-f]{6}$/i.test(hex) ? hex : '#4B5563';
  const ch = [1,3,5].map(i => { const v = parseInt(h.slice(i,i+2),16)/255; return v <= .03928 ? v/12.92 : Math.pow((v+.055)/1.055, 2.4); });
  const L = .2126*ch[0] + .7152*ch[1] + .0722*ch[2];
  return (1.05)/(L+.05) >= (L+.05)/(0.0118+.05) ? '#FFFFFF' : '#0E1B2C';
}
