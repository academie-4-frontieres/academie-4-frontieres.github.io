setSound(false);
buildDiscForm();

sb.auth.onAuthStateChange((event) => {
  if (event === 'PASSWORD_RECOVERY'){ changingPw = false; setTimeout(() => showAuth('reset'), 0); }
});

(function boot(){
  const h = location.hash || '';
  if (/error_description=/.test(h)){
    const p = new URLSearchParams(h.slice(1));
    history.replaceState(null, '', APP_URL);
    showAuth('login');
    say($('authNotice'), /expired/i.test(p.get('error_description') || '') ? 'Ce lien a expiré. Connectez-vous, ou demandez un nouvel e-mail.' : 'Ce lien n\'est pas valide : ' + (p.get('error_description') || ''), true);
    return;
  }
  if (/access_token=|type=recovery|type=signup/.test(h)){
    const recovery = /type=recovery/.test(h);
    setTimeout(async () => {
      history.replaceState(null, '', APP_URL);
      if (recovery) showAuth('reset'); else await route();
    }, 300);
  }
})();

</script>
