async function discAct(kind, id, value){
  const n = $('notice'), d = discById(id); if (!d) return;
  const t = sb.from('disciplines');
  try {
    if (kind === 'status'){ await q(t.update({ status:value }).eq('id', id)); say(n, `${d.name} : porte ${value === 'active' ? 'ouverte' : 'fermée (bientôt)'}.`); }
    if (kind === 'archive'){ armedDelete = null; await q(t.update({ status:'archived', archived_at:new Date().toISOString() }).eq('id', id)); say(n, `${d.name} a été retirée. Ses données sont conservées ; vous pouvez la restaurer.`); }
    if (kind === 'restore'){ armedDelete = null; const max = Math.max(0, ...S.disciplines.filter(x => x.status !== 'archived').map(x => x.sort_order || 0)); await q(t.update({ status:'soon', archived_at:null, sort_order:max + 1 }).eq('id', id)); say(n, `${d.name} est restaurée avec une porte « Bientôt ».`); }
    if (kind === 'delete'){
      if (armedDelete !== id){ armedDelete = id; renderManage(); say(n, `Touchez « Confirmer la suppression » pour supprimer ${d.name} définitivement. Cette action est irréversible.`, true); return; }
      armedDelete = null;
      try { await q(t.delete().eq('id', id)); say(n, `${d.name} a été supprimée définitivement.`); }
      catch (err) { if (err.code === '23503'){ say(n, `Suppression impossible : ${d.name} contient encore des profils ou des modules de formation. Gardez-la retirée, ou supprimez d'abord ces données.`, true); } else throw err; }
    }
    if (kind === 'up' || kind === 'down'){
      const live = S.disciplines.filter(x => x.status !== 'archived');
      const i = live.findIndex(x => x.id === id), j = kind === 'up' ? i - 1 : i + 1;
      if (j < 0 || j >= live.length) return;
      const reordered = live.slice(); [reordered[i], reordered[j]] = [reordered[j], reordered[i]];
      for (let k = 0; k < reordered.length; k++) if (reordered[k].sort_order !== k + 1) await q(t.update({ sort_order:k + 1 }).eq('id', reordered[k].id));
      say(n, `Ordre mis à jour : ${d.name} ${kind === 'up' ? 'monte' : 'descend'} d'un rang.`);
    }
    await loadDisciplines(); renderDoors(); renderManage();
  } catch (err) { say(n, frErr(err), true); }
}
