<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="description" content="Académie des 4 Frontières · Grande Région : gestion de l'académie sportive pluridisciplinaire.">
<meta name="theme-color" content="#0E1B2C">
<meta name="robots" content="noindex">
<title>Académie des 4 Frontières</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='-8 -8 216 216'><circle cx='100' cy='100' r='108' fill='%23FFFFFF'/> <path d='M94,94 L94,4 A90,90 0 0,0 4,94 Z' fill='%23FDDA24'/> <path d='M106,94 L196,94 A90,90 0 0,0 106,4 Z' fill='%2300A1DE'/> <path d='M106,106 L106,196 A90,90 0 0,0 196,106 Z' fill='%2316181D'/> <path d='M94,106 L4,106 A90,90 0 0,0 94,196 Z' fill='%2312318F'/> <circle cx='100' cy='100' r='27' fill='%23D52B1E' stroke='%23FFFFFF' stroke-width='6'/> <text x='100' y='113' text-anchor='middle' font-family='Barlow Condensed, Arial Narrow, sans-serif' font-weight='800' font-size='36' fill='%23FFFFFF'>4</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Barlow:wght@400;500;600&display=swap">
<style>
:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
/* Layout: application plein écran en quatre scènes successives — accueil → animation des disciplines → portes (avec gestion des disciplines) → espace discipline. Ambiance stade de nuit, couleurs de la charte. */
:root{
  --night:#0E1B2C;
  --night-2:#15263D;
  --night-3:#1C3050;
  --line:#2A3F60;
  --ink:#F4F6FA;
  --muted:#A9B4C6;
  --red:#E5483A;
  --ok:#4ADE80;
  --font-display:'Barlow Condensed','Arial Narrow',sans-serif;
  --font-body:'Barlow','Segoe UI',system-ui,sans-serif;
  color-scheme:dark;
}
html,body{height:100%}
body{background:var(--night);color:var(--ink);font-family:var(--font-body);font-size:16px;line-height:1.5}
*{box-sizing:border-box}
[hidden]{display:none!important}
button,input,select{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--ink);outline-offset:3px}

.scene{min-height:100%;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:72px 40px}

/* Bouton son */
.sound{position:fixed;z-index:20;top:calc(12px + env(safe-area-inset-top,0px));right:calc(12px + env(safe-area-inset-right,0px));display:flex;align-items:center;gap:8px;min-height:44px;padding:0 14px;border-radius:999px;border:1px solid var(--line);background:var(--night-2);cursor:pointer;font-size:14px;font-weight:500}
.sound svg{width:18px;height:18px}

/* Scène 1 : accueil */
#start{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:20px}
.emblem{width:132px;height:132px}
.eyebrow{font-family:var(--font-display);font-weight:600;font-size:14px;letter-spacing:.24em;text-transform:uppercase;color:var(--muted)}
h1{margin:0;font-family:var(--font-display);font-weight:800;font-size:clamp(44px,9vw,92px);line-height:.95;text-transform:uppercase;text-wrap:balance}
.four{color:var(--red)}
.lead{margin:0;max-width:36ch;color:var(--muted);font-size:18px}
.actions{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;margin-top:8px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:0 26px;border-radius:999px;border:2px solid var(--ink);background:var(--ink);color:var(--night);font-family:var(--font-display);font-weight:700;font-size:20px;letter-spacing:.06em;text-transform:uppercase;cursor:pointer;transition:transform .15s}
.btn:hover{transform:translateY(-2px)}
.btn.ghost{background:transparent;color:var(--ink);border-color:var(--line)}
.btn.small{min-height:44px;font-size:17px;padding:0 18px}
.btn svg{width:22px;height:22px}

/* Scène 2 : animation */
#intro{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;overflow:hidden;--c:#187A42;background:radial-gradient(120% 80% at 50% 45%, color-mix(in srgb,var(--c) 55%,var(--night)) 0%, var(--night) 70%);transition:background .6s}
.motif{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:var(--ink);opacity:.13;pointer-events:none}
.motif svg{width:min(1100px,140%);height:auto}
.seg{position:relative;display:flex;flex-direction:column;align-items:center;gap:14px}
.seg-count{font-family:var(--font-display);font-weight:600;font-size:16px;letter-spacing:.3em;color:var(--muted);font-variant-numeric:tabular-nums}
.seg-icon{width:clamp(110px,22vw,170px);height:clamp(110px,22vw,170px);color:var(--ink)}
.seg-icon svg{width:100%;height:100%}
.seg-name{margin:0;font-family:var(--font-display);font-weight:800;font-size:clamp(56px,14vw,200px);line-height:.9;text-transform:uppercase;letter-spacing:.01em;overflow-wrap:anywhere}
.seg-tag{margin:0;font-size:clamp(17px,2.4vw,22px);color:var(--ink);opacity:.85}
.enter .motif svg{animation:drift 3.6s ease-out both}
.enter .seg-icon{animation:pop .7s cubic-bezier(.2,.9,.3,1.3) both}
.enter .seg-name{animation:rise .6s .15s cubic-bezier(.2,.8,.2,1) both}
.enter .seg-tag{animation:fade .5s .4s both}
@keyframes drift{from{transform:scale(1.12)}to{transform:scale(1)}}
@keyframes pop{from{transform:scale(.3) rotate(-90deg);opacity:0}to{transform:none;opacity:1}}
@keyframes rise{from{transform:translateY(40px);opacity:0}to{transform:none;opacity:1}}
@keyframes fade{from{opacity:0}to{opacity:.85}}
.progress{position:absolute;left:50%;transform:translateX(-50%);bottom:calc(84px + env(safe-area-inset-bottom,0px));display:flex;gap:6px;width:min(320px,70%)}
.progress span{flex:1;height:4px;border-radius:2px;background:var(--line);overflow:hidden}
.progress span i{display:block;height:100%;width:0;background:var(--ink)}
.progress span.done i{width:100%}
.progress span.now i{animation:fill var(--d,3.6s) linear forwards}
@keyframes fill{to{width:100%}}
.skip{position:absolute;right:max(16px,env(safe-area-inset-right,0px));bottom:calc(16px + env(safe-area-inset-bottom,0px));min-height:44px;padding:0 18px;border-radius:999px;border:1px solid var(--line);background:color-mix(in srgb,var(--night) 70%,transparent);cursor:pointer;font-weight:600}

/* Scène 3 : portes */
.wrap{max-width:1120px;margin:0 auto;display:flex;flex-direction:column;gap:28px}
.doors-head{display:flex;flex-wrap:wrap;align-items:center;gap:16px 20px}
.doors-head .emblem{width:64px;height:64px;flex:none}
.doors-head > div{min-width:0;flex:1 1 280px}
h2{margin:0;font-family:var(--font-display);font-weight:800;font-size:clamp(34px,5vw,54px);line-height:1;text-transform:uppercase;text-wrap:balance}
h3{margin:0;font-family:var(--font-display);font-weight:700;font-size:26px;letter-spacing:.02em;text-transform:uppercase}
.sub{margin:6px 0 0;color:var(--muted);max-width:62ch}
.doors{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:20px}
.door{position:relative;width:100%;aspect-ratio:3/5;border:none;padding:0;border-radius:16px 16px 6px 6px;background:var(--night-2);box-shadow:inset 0 0 0 2px var(--line);perspective:900px;cursor:pointer;text-align:center}
.door-inside{position:absolute;inset:10px;border-radius:9px 9px 3px 3px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;background:radial-gradient(circle at 50% 45%, color-mix(in srgb,var(--c) 75%,#fff 25%) 0%, var(--c) 45%, var(--night) 100%);color:var(--on)}
.door-inside svg{width:56px;height:56px}
.door-inside b{font-family:var(--font-display);font-size:22px;letter-spacing:.12em;text-transform:uppercase}
.leaf{position:absolute;inset:10px;border-radius:9px 9px 3px 3px;background:linear-gradient(160deg, color-mix(in srgb,var(--c) 88%,#fff 12%), var(--c) 55%, color-mix(in srgb,var(--c) 78%,#000 22%));color:var(--on);transform-origin:left center;transition:transform .9s cubic-bezier(.6,.05,.25,1),filter .3s;box-shadow:0 10px 30px rgba(0,0,0,.35);display:flex;flex-direction:column;align-items:center;padding:18px 12px;gap:10px}
.leaf::before,.leaf::after{content:"";position:absolute;left:16%;right:16%;border:2px solid color-mix(in srgb,var(--on) 30%,transparent);border-radius:6px}
.leaf::before{top:40%;height:21%}
.leaf::after{top:66%;height:22%}
.plaque{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;gap:8px}
.plaque svg{width:44px;height:44px}
.plaque strong{font-family:var(--font-display);font-weight:800;font-size:clamp(19px,2.3vw,26px);line-height:1;text-transform:uppercase;overflow-wrap:anywhere}
.status{position:relative;z-index:1;margin-top:auto;font-size:13px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;padding:4px 10px;border-radius:999px;background:color-mix(in srgb,var(--on) 16%,transparent)}
.knob{position:absolute;right:12%;top:52%;width:12px;height:12px;border-radius:50%;background:color-mix(in srgb,var(--on) 70%,transparent);box-shadow:0 0 0 3px color-mix(in srgb,var(--on) 18%,transparent)}
.door[data-status="active"]:hover .leaf,.door[data-status="active"]:focus-visible .leaf{transform:rotateY(-16deg)}
.door.open .leaf{transform:rotateY(-108deg)!important}
.door[data-status="soon"] .leaf{filter:saturate(.55) brightness(.85)}
.door.locked .leaf{animation:shake .45s}
@keyframes shake{20%{transform:rotateY(-6deg)}40%{transform:rotateY(3deg)}60%{transform:rotateY(-4deg)}80%{transform:rotateY(2deg)}}
.door-new{aspect-ratio:3/5;width:100%;border-radius:16px 16px 6px 6px;border:2px dashed var(--line);background:transparent;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:16px;color:var(--muted);text-align:center;font-size:15px}
button.door-new{cursor:pointer}
button.door-new:hover{border-color:var(--muted)}
.door-new svg{width:36px;height:36px}
.door-new strong{font-family:var(--font-display);font-size:22px;text-transform:uppercase;color:var(--ink)}
.empty{grid-column:1/-1;padding:28px;border:2px dashed var(--line);border-radius:14px;color:var(--muted);text-align:center}
.notice{min-height:24px;margin:0;color:var(--muted);font-weight:500}
.notice.error{color:#FCA5A5}
.row-links{display:flex;flex-wrap:wrap;gap:8px 24px}
.link{min-height:44px;padding:0;border:none;background:none;color:var(--ink);text-decoration:underline;text-underline-offset:4px;cursor:pointer;font-weight:600}

/* Gestion des disciplines */
.manage{display:flex;flex-direction:column;gap:22px;padding:22px;border-radius:16px;background:var(--night-2);border:1px solid var(--line)}
.manage-head{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:8px 16px}
.manage-head p{margin:0;color:var(--muted);max-width:60ch}
.list{display:flex;flex-direction:column;gap:10px;margin:0;padding:0;list-style:none}
.item{display:flex;flex-wrap:wrap;align-items:center;gap:10px 14px;padding:12px;border-radius:12px;background:var(--night-3)}
.swatch{width:44px;height:44px;flex:none;border-radius:10px;display:flex;align-items:center;justify-content:center;background:var(--c);color:var(--on)}
.swatch svg{width:26px;height:26px}
.item-name{flex:1 1 160px;min-width:0}
.item-name strong{display:block;font-family:var(--font-display);font-size:22px;line-height:1.1}
.item-name span{color:var(--muted);font-size:14px}
.item-tools{display:flex;flex-wrap:wrap;align-items:center;gap:8px}
.ctl{min-height:44px;padding:0 14px;border-radius:10px;border:1px solid var(--line);background:var(--night-2);cursor:pointer;font-weight:600;font-size:15px}
.ctl:hover{border-color:var(--muted)}
.ctl:disabled{opacity:.4;cursor:default}
.ctl.icon{width:44px;padding:0;display:inline-flex;align-items:center;justify-content:center}
.ctl.icon svg{width:20px;height:20px}
.ctl.danger{border-color:#7F2A2A;color:#FCA5A5}
.ctl.danger.armed{background:#7F2A2A;color:#FFFFFF}
select.ctl{padding-right:8px}
.subhead{font-family:var(--font-display);font-weight:700;font-size:18px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin:4px 0 0}
.form{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px}
.field{display:flex;flex-direction:column;gap:6px;min-width:0}
.field label{font-size:14px;font-weight:600;color:var(--muted)}
.field input[type=text],.field select{min-height:44px;padding:0 12px;border-radius:10px;border:1px solid var(--line);background:var(--night);width:100%}
.colors{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.colors button{width:36px;height:36px;border-radius:50%;border:2px solid transparent;cursor:pointer;padding:0}
.colors button[aria-pressed="true"]{border-color:var(--ink);box-shadow:0 0 0 2px var(--night)}
.colors input[type=color]{width:44px;height:36px;border:1px solid var(--line);border-radius:8px;background:var(--night);padding:2px}
.form-actions{grid-column:1/-1;display:flex;flex-wrap:wrap;align-items:center;gap:12px}
.form-actions .notice{flex:1 1 220px}

/* Scène 4 : espace discipline */
.space-head{display:flex;flex-wrap:wrap;align-items:center;gap:16px}
.space-icon{width:72px;height:72px;flex:none;border-radius:18px;display:flex;align-items:center;justify-content:center;background:var(--c);color:var(--on)}
.space-icon svg{width:44px;height:44px}
.space-head > div:not(.space-icon){min-width:0;flex:1 1 260px}
.modules{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:14px}
.module{display:flex;flex-direction:column;gap:6px;padding:18px;border-radius:12px;background:var(--night-2);border:1px solid var(--line)}
.module h3{font-size:22px;text-transform:none}
.module p{margin:0;color:var(--muted);font-size:15px}
.chip{align-self:flex-start;margin-top:6px;font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;padding:3px 9px;border-radius:999px;border:1px solid var(--line);color:var(--muted)}

button.module{text-align:left;cursor:pointer;border-color:var(--c);color:var(--ink)}
button.module:hover{background:var(--night-3)}
.chip.on{border-color:var(--ok);color:var(--ok)}

/* Scène 5 : formations */
.tabs{display:flex;flex-wrap:wrap;gap:8px;border-bottom:1px solid var(--line)}
.tab{min-height:48px;padding:0 18px;border:none;border-bottom:3px solid transparent;background:none;cursor:pointer;font-family:var(--font-display);font-weight:700;font-size:20px;letter-spacing:.04em;text-transform:uppercase;color:var(--muted)}
.tab[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--c)}
.tab span{font-family:var(--font-body);font-size:14px;font-weight:600;margin-left:6px;font-variant-numeric:tabular-nums}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}
.stat{padding:14px 16px;border-radius:12px;background:var(--night-2);border:1px solid var(--line)}
.stat b{display:block;font-family:var(--font-display);font-size:32px;line-height:1;font-variant-numeric:tabular-nums}
.stat span{color:var(--muted);font-size:14px}
.toolbar{display:flex;flex-wrap:wrap;align-items:flex-end;gap:12px}
.toolbar .field{flex:0 1 210px}
.toolbar .spacer{flex:1 1 0}
.check{display:flex;align-items:center;gap:8px;min-height:44px;color:var(--muted);font-weight:600;font-size:15px}
.check input{width:20px;height:20px}
.fm-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px}
.fm{display:flex;flex-direction:column;gap:10px;padding:18px;border-radius:12px;background:var(--night-2);border:1px solid var(--line);min-width:0}
.fm.archived{opacity:.65}
.fm-top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}
.fm h3{font-size:22px;text-transform:none;line-height:1.15;overflow-wrap:anywhere}
.pill{flex:none;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:3px 9px;border-radius:999px}
.pill.actif{background:color-mix(in srgb,var(--ok) 18%,transparent);color:var(--ok)}
.pill.brouillon{background:color-mix(in srgb,#FBBF24 18%,transparent);color:#FBBF24}
.pill.archive{background:var(--night-3);color:var(--muted)}
.tags{display:flex;flex-wrap:wrap;gap:6px}
.tags .chip{margin:0}
.facts{display:flex;flex-wrap:wrap;gap:4px 16px;margin:0;color:var(--muted);font-size:14px;font-variant-numeric:tabular-nums}
.facts b{color:var(--ink);font-weight:600}
.fm p.obj{margin:0;font-size:15px;color:var(--ink)}
.fm .item-tools{margin-top:auto}
.panel{display:flex;flex-direction:column;gap:16px;padding:20px;border-radius:16px;background:var(--night-2);border:1px solid var(--c)}
.field textarea{min-height:88px;padding:10px 12px;border-radius:10px;border:1px solid var(--line);background:var(--night);width:100%;resize:vertical;font:inherit;color:inherit}
.field input[type=number]{min-height:44px;padding:0 12px;border-radius:10px;border:1px solid var(--line);background:var(--night);width:100%}
.field.wide{grid-column:1/-1}
.field input[type=date],.field input[type=email],.field input[type=tel]{min-height:44px;padding:0 12px;border-radius:10px;border:1px solid var(--line);background:var(--night);width:100%}
input.ctl{min-height:44px;width:100%;cursor:text}
.kin{display:flex;flex-direction:column;gap:6px;margin:0;padding:10px 12px;border-radius:10px;background:var(--night-3);list-style:none}
.kin li{display:flex;flex-wrap:wrap;gap:4px 10px;font-size:15px}
.kin li b{min-width:58px}
.kin li span{color:var(--muted)}
.kin-head{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:14px;font-weight:600;color:var(--muted)}

/* Connexion */
#login{display:flex;align-items:center;justify-content:center}
.login{width:100%;max-width:1040px;display:flex;flex-wrap:wrap;gap:24px;align-items:flex-start}
.login-card{flex:1 1 340px;min-width:0;display:flex;flex-direction:column;gap:18px;padding:28px;border-radius:18px;background:var(--night-2);border:1px solid var(--line)}
.login-card .emblem{width:72px;height:72px}
.login-card form{display:flex;flex-direction:column;gap:14px}
.login-card .field input{min-height:48px;padding:0 12px;border-radius:10px;border:1px solid var(--line);background:var(--night);width:100%}
.pw{position:relative}
.pw input{padding-right:110px!important}
.pw button{position:absolute;right:4px;top:50%;transform:translateY(-50%);min-height:40px;padding:0 12px;border:none;border-radius:8px;background:var(--night-3);cursor:pointer;font-size:14px;font-weight:600}
.demo{flex:1 1 360px;min-width:0;display:flex;flex-direction:column;gap:12px;padding:22px;border-radius:18px;border:2px dashed var(--line)}
.demo table{width:100%;border-collapse:collapse;font-size:15px}
.demo th{text-align:left;font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);padding:6px 8px}
.demo td{padding:8px;border-top:1px solid var(--line);vertical-align:middle}
.demo code{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:14px}
.tbl{overflow-x:auto}
.banner{padding:10px 14px;border-radius:10px;background:color-mix(in srgb,#FBBF24 14%,transparent);color:#FDE68A;font-size:14px}
/* Tableau de bord */
.dash-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px}
.card{display:flex;flex-direction:column;gap:10px;padding:18px;border-radius:12px;background:var(--night-2);border:1px solid var(--line);min-width:0}
.card h3{font-size:22px;text-transform:none}
.card ul{margin:0;padding-left:18px;display:flex;flex-direction:column;gap:4px}
.card .facts{margin:0}
.rights{display:flex;flex-wrap:wrap;gap:6px}
.rights .chip{margin:0}
.chip.no{opacity:.75;border-style:dashed}

@media (prefers-reduced-motion:reduce){
  .enter .motif svg,.enter .seg-icon,.enter .seg-name,.enter .seg-tag,.door.locked .leaf{animation:none}
  .leaf{transition:none}
}
/* Compléments pour l'application connectée */
.busy{position:fixed;z-index:50;left:50%;transform:translateX(-50%);bottom:calc(20px + env(safe-area-inset-bottom,0px));display:flex;align-items:center;gap:10px;padding:10px 16px;border-radius:999px;background:var(--night-2);border:1px solid var(--line);font-weight:600;font-size:15px;box-shadow:0 8px 24px rgba(0,0,0,.35)}
.spinner{width:16px;height:16px;border-radius:50%;border:2px solid var(--line);border-top-color:var(--ink);animation:spin .8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.hint{color:var(--muted);font-size:14px;font-variant-numeric:tabular-nums}
.hint.ok{color:var(--ok)}
.flabel{font-size:14px;font-weight:600;color:var(--muted)}
.age-out{min-height:44px;display:flex;align-items:center;font-family:var(--font-display);font-size:26px;font-weight:700}
.sub-grid{display:contents}
.photo-row{display:flex;flex-wrap:wrap;align-items:center;gap:16px}
.photo-row input{min-height:44px;max-width:100%}
.photo-prev{width:96px;height:96px;object-fit:cover;border-radius:12px;border:1px solid var(--line)}
.code-input{min-height:56px!important;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:26px;letter-spacing:.35em;max-width:280px}
.steps{margin:0;padding-left:20px;display:flex;flex-direction:column;gap:10px;color:var(--ink)}
.steps b{font-weight:600}
.stack{display:flex;flex-direction:column;gap:22px}
.login-card form{display:flex;flex-direction:column;gap:14px}
.login-card .tabs{margin-top:-4px}
.field input[type=text],.field input[type=email],.field input[type=password],.field input[type=tel],.field input[type=date],.field input[type=number],.field select,.field textarea{min-height:44px;padding:0 12px;border-radius:10px;border:1px solid var(--line);background:var(--night);width:100%;color:var(--ink);font:inherit}
.field textarea{padding:10px 12px;min-height:88px;resize:vertical}
.pw input{padding-right:110px!important}
.check{display:flex;align-items:flex-start;gap:10px;min-height:44px;color:var(--muted);font-weight:500;font-size:15px}
.check input{width:20px;height:20px;margin-top:2px;flex:none}
.avatar{width:56px;height:56px;flex:none;border-radius:12px;object-fit:cover;border:1px solid var(--line);background:var(--night-3);display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-weight:800;font-size:20px;color:var(--ink)}
.acc{font-size:13px;font-weight:600;padding:3px 9px;border-radius:999px;border:1px solid var(--line);color:var(--muted)}
.acc.on{border-color:var(--ok);color:var(--ok)}
.acc.wait{border-color:#FBBF24;color:#FBBF24}
.empty p{margin:12px 0 0}

</style>
</head>
<body>
<div class="busy" id="busy" hidden role="status" aria-live="polite"><span class="spinner" aria-hidden="true"></span><span id="busyText">Chargement…</span></div>

<button class="sound" id="soundBtn" type="button" aria-pressed="false">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z"/><path id="soundWave" d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12"/><path id="soundOff" d="M17 9l5 6M22 9l-5 6"/></svg>
  <span id="soundLabel">Son coupé</span>
</button>

<!-- Accueil -->
<section class="scene" id="start" aria-labelledby="startTitle">
  <svg class="emblem" viewBox="-8 -8 216 216" role="img" aria-label="Emblème de l'Académie des 4 Frontières"><circle cx="100" cy="100" r="108" fill="#FFFFFF"/>
<path d="M94,94 L94,4 A90,90 0 0,0 4,94 Z" fill="#FDDA24"/>
<path d="M106,94 L196,94 A90,90 0 0,0 106,4 Z" fill="#00A1DE"/>
<path d="M106,106 L106,196 A90,90 0 0,0 196,106 Z" fill="#16181D"/>
<path d="M94,106 L4,106 A90,90 0 0,0 94,196 Z" fill="#12318F"/>
<circle cx="100" cy="100" r="27" fill="#D52B1E" stroke="#FFFFFF" stroke-width="6"/>
<text x="100" y="113" text-anchor="middle" font-family="Barlow Condensed, Arial Narrow, sans-serif" font-weight="800" font-size="36" fill="#FFFFFF">4</text></svg>
  <span class="eyebrow">Grande Région · B · D · F · L</span>
  <h1 id="startTitle">Académie des <span class="four">4</span> Frontières</h1>
  <p class="lead">Une académie, plusieurs disciplines. Chaque discipline a son espace et ses spécificités.</p>
  <div class="actions">
    <button class="btn" id="enterSound" type="button">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z"/><path d="M16.5 8.5a5 5 0 0 1 0 7"/></svg>
      Entrer
    </button>
    <button class="btn ghost" id="enterMute" type="button">Entrer sans le son</button>
  </div>
  <button class="link" id="skipToLogin" type="button">Passer l'animation et se connecter</button>
</section>

<!-- Animation -->
<section class="scene" id="intro" hidden aria-live="polite">
  <div class="motif" id="motif" aria-hidden="true"></div>
  <div class="seg" id="seg"></div>
  <div class="progress" id="progress" aria-hidden="true"></div>
  <button class="skip" id="skipBtn" type="button">Passer l'animation</button>
</section>

<!-- Connexion / inscription -->
<section class="scene" id="auth" hidden aria-labelledby="authTitle">
  <div class="login">
    <div class="login-card">
      <svg class="emblem" style="width:72px;height:72px" viewBox="-8 -8 216 216" aria-hidden="true"><circle cx="100" cy="100" r="108" fill="#FFFFFF"/>
<path d="M94,94 L94,4 A90,90 0 0,0 4,94 Z" fill="#FDDA24"/>
<path d="M106,94 L196,94 A90,90 0 0,0 106,4 Z" fill="#00A1DE"/>
<path d="M106,106 L106,196 A90,90 0 0,0 196,106 Z" fill="#16181D"/>
<path d="M94,106 L4,106 A90,90 0 0,0 94,196 Z" fill="#12318F"/>
<circle cx="100" cy="100" r="27" fill="#D52B1E" stroke="#FFFFFF" stroke-width="6"/>
<text x="100" y="113" text-anchor="middle" font-family="Barlow Condensed, Arial Narrow, sans-serif" font-weight="800" font-size="36" fill="#FFFFFF">4</text></svg>
      <div>
        <h2 id="authTitle">Connexion</h2>
        <p class="sub" id="authSub">Identifiez-vous pour accéder à votre espace.</p>
      </div>
      <div class="tabs" role="tablist" aria-label="Connexion ou création de compte" id="authTabs">
        <button class="tab" role="tab" type="button" id="tabLogin" aria-selected="true" data-panel="login">Connexion</button>
        <button class="tab" role="tab" type="button" id="tabSignup" aria-selected="false" data-panel="signup" tabindex="-1">Créer mon compte</button>
      </div>

      <form id="fLogin" novalidate>
        <div class="field"><label for="lEmail">Adresse e-mail</label><input type="email" id="lEmail" autocomplete="username" autocapitalize="none" spellcheck="false" inputmode="email"></div>
        <div class="field"><label for="lPass">Mot de passe</label>
          <div class="pw"><input type="password" id="lPass" autocomplete="current-password"><button type="button" data-showpw="lPass" aria-pressed="false">Afficher</button></div>
        </div>
        <button class="btn" type="submit" id="lSubmit">Se connecter</button>
        <button class="link" type="button" data-panel-go="forgot">Mot de passe oublié ?</button>
      </form>

      <form id="fSignup" novalidate hidden>
        <p class="sub" style="margin:0">Utilisez l'adresse e-mail que vous avez communiquée à l'académie.</p>
        <div class="field"><label for="sEmail">Adresse e-mail</label><input type="email" id="sEmail" autocomplete="username" autocapitalize="none" spellcheck="false" inputmode="email"></div>
        <div class="field"><label for="sPass">Mot de passe</label>
          <div class="pw"><input type="password" id="sPass" autocomplete="new-password"><button type="button" data-showpw="sPass" aria-pressed="false">Afficher</button></div>
          <span class="hint" id="sPassHint">8 caractères minimum, avec des lettres et des chiffres</span>
        </div>
        <div class="field"><label for="sPass2">Confirmer le mot de passe</label><input type="password" id="sPass2" autocomplete="new-password"></div>
        <button class="btn" type="submit" id="sSubmit">Créer mon compte</button>
      </form>

      <form id="fVerify" novalidate hidden>
        <p class="sub" style="margin:0" id="vText"></p>
        <div class="field"><label for="vCode">Code reçu par e-mail (si l'e-mail contient un code)</label>
          <input type="text" id="vCode" inputmode="numeric" autocomplete="one-time-code" maxlength="10" class="code-input">
        </div>
        <button class="btn" type="submit" id="vSubmit">Valider le code</button>
        <div class="row-links">
          <button class="link" type="button" id="vResend">Renvoyer l'e-mail</button>
          <button class="link" type="button" data-panel-go="login">J'ai cliqué sur le lien : me connecter</button>
        </div>
      </form>

      <form id="fForgot" novalidate hidden>
        <p class="sub" style="margin:0">Indiquez votre adresse e-mail : vous recevrez un lien pour choisir un nouveau mot de passe.</p>
        <div class="field"><label for="fEmail">Adresse e-mail</label><input type="email" id="fEmail" autocomplete="username" autocapitalize="none" spellcheck="false" inputmode="email"></div>
        <button class="btn" type="submit" id="fSubmit">Recevoir le lien</button>
        <button class="link" type="button" data-panel-go="login">Retour à la connexion</button>
      </form>

      <form id="fReset" novalidate hidden>
        <p class="sub" style="margin:0" id="rText">Choisissez votre nouveau mot de passe.</p>
        <div class="field"><label for="rPass">Nouveau mot de passe</label>
          <div class="pw"><input type="password" id="rPass" autocomplete="new-password"><button type="button" data-showpw="rPass" aria-pressed="false">Afficher</button></div>
          <span class="hint">8 caractères minimum, avec des lettres et des chiffres</span>
        </div>
        <div class="field"><label for="rPass2">Confirmer le mot de passe</label><input type="password" id="rPass2" autocomplete="new-password"></div>
        <button class="btn" type="submit" id="rSubmit">Enregistrer le mot de passe</button>
        <button class="link" type="button" id="rCancel" hidden>Annuler</button>
      </form>

      <p class="notice" id="authNotice" role="alert"></p>
    </div>
    <aside class="demo" aria-labelledby="howTitle">
      <h3 id="howTitle">Comment accéder à l'application ?</h3>
      <ol class="steps">
        <li><b>L'académie enregistre votre adresse e-mail</b> et votre profil (joueur, parent, formateur…).</li>
        <li><b>Créez votre compte</b> avec cette même adresse et un mot de passe personnel.</li>
        <li><b>Confirmez votre adresse</b> grâce à l'e-mail reçu.</li>
        <li><b>Complétez votre fiche</b> lors de votre première connexion.</li>
      </ol>
      <p class="sub" style="margin:0">Votre adresse n'est pas encore enregistrée ? Contactez l'administration de l'académie.</p>
    </aside>
  </div>
</section>

<!-- Compte non rattaché -->
<section class="scene" id="pending" hidden aria-labelledby="pTitle">
  <div class="wrap" style="max-width:640px">
    <div>
      <span class="eyebrow">Compte créé</span>
      <h2 id="pTitle">Votre accès n'est pas encore ouvert</h2>
      <p class="sub" id="pText"></p>
    </div>
    <div class="row-links">
      <button class="btn small" type="button" id="pRetry">Réessayer</button>
      <button class="link" type="button" data-logout>Se déconnecter</button>
    </div>
    <p class="notice" id="pNotice" role="status"></p>
  </div>
</section>

<!-- Première connexion / modification de la fiche -->
<section class="scene" id="onboard" hidden aria-labelledby="obTitle">
  <div class="wrap" style="max-width:760px">
    <div>
      <span class="eyebrow" id="obEyebrow">Première connexion</span>
      <h2 id="obTitle">Complétez votre fiche</h2>
      <p class="sub" id="obSub"></p>
    </div>
    <form class="panel form" id="obForm" novalidate style="--c:var(--line)">
      <div class="field"><label for="oLast">Nom</label><input type="text" id="oLast" maxlength="40" autocomplete="family-name"></div>
      <div class="field"><label for="oFirst">Prénoms</label><input type="text" id="oFirst" maxlength="60" autocomplete="given-name"></div>
      <div class="field"><label for="oBirth">Date de naissance</label><input type="date" id="oBirth"></div>
      <div class="field"><span class="flabel">Âge</span><output id="oAge" for="oBirth" class="age-out">—</output></div>
      <div class="field"><label for="oPhone">Téléphone (facultatif)</label><input type="tel" id="oPhone" maxlength="30" autocomplete="tel"></div>

      <div id="obPlayer" class="sub-grid">
        <p class="subhead field wide">Fiche de l'académicien joueur</p>
        <div class="field wide">
          <label for="oPhoto">Photo d'identité</label>
          <div class="photo-row">
            <img id="oPhotoPrev" alt="Aperçu de la photo" hidden class="photo-prev">
            <input type="file" id="oPhoto" accept="image/jpeg,image/png,image/webp">
          </div>
          <span class="hint">JPG, PNG ou WebP, 10 Mo maximum. La photo est recadrée et redimensionnée automatiquement.</span>
        </div>
        <div class="field"><label for="oHeight">Taille (cm)</label><input type="number" id="oHeight" min="80" max="230" step="1" inputmode="numeric"></div>
        <div class="field"><label for="oWeight">Poids (kg)</label><input type="number" id="oWeight" min="15" max="150" step="0.1" inputmode="decimal"></div>
        <div class="field"><label for="oShoe">Pointure (EU)</label><input type="number" id="oShoe" min="25" max="50" step="0.5" inputmode="decimal"></div>
        <div class="field"><label for="oSize">Taille de vêtements</label><select id="oSize"><option value="">Choisir</option><option>S</option><option>M</option><option>L</option><option>XL</option><option>XXL</option></select></div>
        <label class="check field wide" for="oConsent"><input type="checkbox" id="oConsent"> <span>J'autorise l'académie à conserver cette photo dans la fiche du joueur, à usage interne. Pour un joueur mineur, cette autorisation est donnée par un parent ou le tuteur légal.</span></label>
      </div>

      <div class="form-actions">
        <button class="btn small" type="submit" id="oSave">Enregistrer</button>
        <button class="btn small ghost" type="button" id="oCancel" hidden>Annuler</button>
        <p class="notice" id="oNotice" role="alert"></p>
      </div>
    </form>
  </div>
</section>

<!-- Portes (administration) -->
<section class="scene" id="doorsScene" hidden aria-labelledby="doorsTitle">
  <div class="wrap">
    <div class="doors-head">
      <svg class="emblem" viewBox="-8 -8 216 216" aria-hidden="true"><circle cx="100" cy="100" r="108" fill="#FFFFFF"/>
<path d="M94,94 L94,4 A90,90 0 0,0 4,94 Z" fill="#FDDA24"/>
<path d="M106,94 L196,94 A90,90 0 0,0 106,4 Z" fill="#00A1DE"/>
<path d="M106,106 L106,196 A90,90 0 0,0 196,106 Z" fill="#16181D"/>
<path d="M94,106 L4,106 A90,90 0 0,0 94,196 Z" fill="#12318F"/>
<circle cx="100" cy="100" r="27" fill="#D52B1E" stroke="#FFFFFF" stroke-width="6"/>
<text x="100" y="113" text-anchor="middle" font-family="Barlow Condensed, Arial Narrow, sans-serif" font-weight="800" font-size="36" fill="#FFFFFF">4</text></svg>
      <div>
        <h2 id="doorsTitle">Choisissez votre discipline</h2>
        <p class="sub" id="whoami"></p>
      </div>
    </div>
    <div class="doors" id="doors"></div>
    <p class="notice" id="notice" role="status"></p>
    <div class="row-links">
      <button class="link" id="replayBtn" type="button">Revoir l'animation</button>
      <button class="link" id="manageBtn" type="button" aria-expanded="false" aria-controls="manage">Gérer les disciplines</button>
      <button class="link" id="adminBtn" type="button">Administrateurs</button>
      <button class="link" type="button" data-editfiche>Mes informations</button>
      <button class="link" type="button" data-changepw>Changer de mot de passe</button>
      <button class="link" type="button" data-logout>Se déconnecter</button>
    </div>

    <section class="manage" id="manage" hidden aria-labelledby="manageTitle">
      <div class="manage-head">
        <h3 id="manageTitle">Gérer les disciplines</h3>
        <p>Retirer une discipline la masque des portes et de l'animation sans effacer ses données. Elle reste restaurable. La suppression définitive n'est possible que pour une discipline retirée qui ne contient plus aucune donnée.</p>
      </div>
      <ul class="list" id="activeList"></ul>
      <p class="subhead" id="archivedHead" hidden>Disciplines retirées</p>
      <ul class="list" id="archivedList"></ul>
      <p class="subhead">Ajouter une discipline</p>
      <form class="form" id="addForm" novalidate>
        <div class="field"><label for="dName">Nom de la discipline</label><input type="text" id="dName" maxlength="28" placeholder="Ex. : Handball"></div>
        <div class="field"><label for="dTag">Accroche (affichée dans l'animation)</label><input type="text" id="dTag" maxlength="60" placeholder="Ex. : Vitesse, précision, collectif"></div>
        <div class="field"><label for="dIcon">Pictogramme</label><select id="dIcon"></select></div>
        <div class="field"><label for="dMusic">Ambiance musicale</label><select id="dMusic"></select></div>
        <div class="field"><label for="dStatus">Statut de la porte</label><select id="dStatus"><option value="soon">Bientôt (porte fermée)</option><option value="active">Ouverte</option></select></div>
        <div class="field"><span class="flabel">Couleur</span><div class="colors" id="colorChoices"></div></div>
        <div class="form-actions">
          <button class="btn small" type="submit" id="addBtn">Ajouter la discipline</button>
          <p class="notice" id="formNotice" role="status"></p>
        </div>
      </form>
    </section>
  </div>
</section>

<!-- Espace discipline (administration) -->
<section class="scene" id="space" hidden aria-labelledby="spaceTitle">
  <div class="wrap">
    <button class="link" id="backBtn" type="button" style="align-self:flex-start">← Retour aux portes</button>
    <div class="space-head">
      <div class="space-icon" id="spaceIcon" aria-hidden="true"></div>
      <div><h2 id="spaceTitle">Espace</h2><p class="sub" id="spaceSub"></p></div>
    </div>
    <div class="modules" id="modules"></div>
  </div>
</section>

<!-- Modules de formation (administration) -->
<section class="scene" id="formations" hidden aria-labelledby="fmTitle">
  <div class="wrap">
    <button class="link" id="fmBack" type="button" style="align-self:flex-start">← Retour à l'espace</button>
    <div class="space-head">
      <div class="space-icon" id="fmIcon" aria-hidden="true"></div>
      <div><h2 id="fmTitle">Modules de formation</h2><p class="sub">Catalogue des modules par profil d'académicien : domaine, niveau, volume horaire, objectifs et évaluation.</p></div>
    </div>
    <div class="tabs" role="tablist" aria-label="Profil d'académicien">
      <button class="tab" role="tab" id="tabJoueur" aria-selected="true" aria-controls="fmPanel" data-profile="joueur" type="button">Académiciens joueurs<span id="cntJoueur">0</span></button>
      <button class="tab" role="tab" id="tabFormateur" aria-selected="false" aria-controls="fmPanel" data-profile="formateur" type="button" tabindex="-1">Académiciens formateurs<span id="cntFormateur">0</span></button>
    </div>
    <div id="fmPanel" role="tabpanel" aria-labelledby="tabJoueur" class="stack">
      <div class="stats" id="fmStats"></div>
      <div class="toolbar">
        <div class="field"><label for="fmDomain">Domaine</label><select id="fmDomain" class="ctl"></select></div>
        <div class="field"><label for="fmLevel" id="fmLevelLabel">Catégorie</label><select id="fmLevel" class="ctl"></select></div>
        <label class="check" for="fmShowArch"><input type="checkbox" id="fmShowArch"> Afficher les modules archivés</label>
        <span class="spacer"></span>
        <button class="btn small" id="fmNew" type="button">Nouveau module</button>
      </div>
      <section class="panel" id="fmEditor" hidden aria-labelledby="fmEditorTitle">
        <h3 id="fmEditorTitle">Nouveau module</h3>
        <form class="form" id="fmForm" novalidate>
          <div class="field wide"><label for="eTitle">Intitulé du module</label><input type="text" id="eTitle" maxlength="80"></div>
          <div class="field"><label for="eDomain">Domaine</label><select id="eDomain"></select></div>
          <div class="field"><label for="eLevel" id="eLevelLabel">Catégorie</label><select id="eLevel"></select></div>
          <div class="field"><label for="eHours">Volume horaire (heures)</label><input type="number" id="eHours" min="0" max="500" step="0.5"></div>
          <div class="field"><label for="eSessions">Nombre de séances</label><input type="number" id="eSessions" min="0" max="200" step="1"></div>
          <div class="field" id="eCertField"><label for="eCert">Certification visée</label><select id="eCert"></select></div>
          <div class="field"><label for="eStatus">Statut</label><select id="eStatus"><option value="brouillon">Brouillon</option><option value="actif">Actif</option></select></div>
          <div class="field wide"><label for="eObj">Objectifs pédagogiques</label><textarea id="eObj" maxlength="600"></textarea></div>
          <div class="field wide"><label for="eEval">Modalités d'évaluation</label><textarea id="eEval" maxlength="400"></textarea></div>
          <div class="form-actions">
            <button class="btn small" type="submit" id="eSave">Enregistrer</button>
            <button class="btn small ghost" type="button" id="eCancel">Annuler</button>
            <p class="notice" id="eNotice" role="alert"></p>
          </div>
        </form>
      </section>
      <p class="notice" id="fmNotice" role="status"></p>
      <div class="fm-list" id="fmList"></div>
    </div>
  </div>
</section>

<!-- Profils (administration) -->
<section class="scene" id="profiles" hidden aria-labelledby="prTitle">
  <div class="wrap">
    <button class="link" id="prBack" type="button" style="align-self:flex-start">← Retour à l'espace</button>
    <div class="space-head">
      <div class="space-icon" id="prIcon" aria-hidden="true"></div>
      <div><h2 id="prTitle">Profils</h2><p class="sub">Les personnes de l'académie par profil. Ces données personnelles, dont celles de mineurs, ne sont visibles que par les administrateurs et les personnes concernées.</p></div>
    </div>
    <div class="tabs" role="tablist" aria-label="Type de profil" id="prTabs"></div>
    <div id="prPanel" role="tabpanel" class="stack">
      <p class="sub" id="prIntro" style="margin:0"></p>
      <div class="stats" id="prStats"></div>
      <div class="toolbar">
        <div class="field"><label for="prSearch">Rechercher</label><input type="text" id="prSearch" class="ctl" placeholder="Nom ou prénom"></div>
        <span class="spacer"></span>
        <button class="btn small" id="prNew" type="button">Nouveau profil</button>
      </div>
      <section class="panel" id="prEditor" hidden aria-labelledby="prEditorTitle">
        <h3 id="prEditorTitle">Nouveau profil</h3>
        <form class="form" id="prForm" novalidate>
          <div id="prFields" class="sub-grid"></div>
          <div class="form-actions">
            <button class="btn small" type="submit" id="prSave">Enregistrer</button>
            <button class="btn small ghost" type="button" id="prCancel">Annuler</button>
            <p class="notice" id="prFormNotice" role="alert"></p>
          </div>
        </form>
      </section>
      <p class="notice" id="prNotice" role="status"></p>
      <div class="fm-list" id="prList"></div>
    </div>
  </div>
</section>

<!-- Administrateurs -->
<section class="scene" id="admin" hidden aria-labelledby="adminTitle">
  <div class="wrap">
    <button class="link" id="adminBack" type="button" style="align-self:flex-start">← Retour aux portes</button>
    <div>
      <h2 id="adminTitle">Administrateurs</h2>
      <p class="sub">Un administrateur a un accès complet à toute l'application. Pour ouvrir un accès, enregistrez l'adresse e-mail de la personne : elle crée ensuite son compte avec cette adresse.</p>
