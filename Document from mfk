  if (/Email not confirmed/i.test(m) || c === 'email_not_confirmed') return "Votre adresse e-mail n'est pas encore confirmée. Cliquez sur le lien reçu par e-mail.";
  if (/already registered|already been registered/i.test(m) || c === 'user_already_exists') return 'Un compte existe déjà avec cette adresse. Connectez-vous, ou utilisez « Mot de passe oublié ».';
  if (c === 'same_password' || /should be different/i.test(m)) return "Le nouveau mot de passe doit être différent de l'actuel.";
  if (c === 'weak_password' || /weak|Password should/i.test(m)) return 'Mot de passe trop faible : 8 caractères minimum, avec des lettres et des chiffres.';
  if (/expired|otp|token/i.test(m) && /invalid|expired/i.test(m)) return 'Code ou lien incorrect ou expiré. Demandez un nouvel e-mail.';
  if (c === '42501' || /réservée à l'administration|row-level security|permission denied/i.test(m)) return "Action non autorisée pour votre profil.";
