const snare = (b,t) => { noise(b,{t,d:.16,v:.32,hp:1800}); tone(b,{t,f:190,d:.08,type:'triangle',v:.18}); };
const clap  = (b,t) => [0,.012,.026].forEach(o => noise(b,{t:t+o,d:.07,v:.28,hp:1200,lp:4500}));
