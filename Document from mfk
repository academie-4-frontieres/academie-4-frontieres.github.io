function bus(t0, dur){ const g = ctx.createGain(); g.gain.setValueAtTime(1,t0); g.gain.setValueAtTime(1,t0+dur-.3); g.gain.linearRampToValueAtTime(.0001,t0+dur+.1); g.connect(master); buses.push(g); return g; }
