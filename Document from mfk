  if (b.dataset.p === 'delete'){
    const otherRoles = rolesOf(p.id).filter(r => !(r.role === pType && r.discipline_id === S.disc.id));
    const kids = pType === 'joueur' ? parentsOf(p.id) : [];
    if (armedP !== p.id){
