        if (pType === 'parent') for (const l of S.d.liens_parent.filter(l => l.parent_id === p.id)) await q(sb.from('liens_parent').delete().eq('joueur_id', l.joueur_id).eq('relation', l.relation));
      } else {
        await q(sb.from('personnes').delete().eq('id', p.id));
